[
  {
    "name": "filesystem",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem", "./src/assets"],
    "description": "Read/write access to the assets directory"
  },
  {
    "name": "git",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-git", "--repository", "."],
    "description": "Git operations on the current repository"
  },
  {
    "name": "fetch",
    "command": "uvx",
    "args": ["mcp-server-fetch"],
    "description": "Fetch web content via the MCP fetch server"
  },
  {
    "name": "github",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-github"],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "replace_with_your_token"
    },
    "description": "GitHub repository and issue management"
  }
]
